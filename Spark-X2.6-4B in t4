        "import subprocess, secrets, time\n",
        "from pathlib import Path\n",
        "import urllib.request\n",
        "\n",
        "MODEL_DIR = \"/content/models/Spark-X2.6-4B\"\n",
        "TEMPLATE  = Path(\"/content/chat_template.jinja\")\n",
        "VLLM_PORT = 8000\n",
        "\n",
        "KEY_FILE = Path(\"/content/api_key.txt\")\n",
        "if KEY_FILE.exists():\n",
        "    API_KEY = KEY_FILE.read_text().strip()\n",
        "else:\n",
        "    API_KEY = secrets.token_hex(16)\n",
        "    KEY_FILE.write_text(API_KEY)\n",
        "\n",
        "if not TEMPLATE.exists():\n",
        "    urllib.request.urlretrieve(\n",
        "        \"https://huggingface.co/XHToken/Spark-X2.6-4B/raw/main/chat_template.jinja\",\n",
        "        TEMPLATE)\n",
        "\n",
        "subprocess.run(\"pkill -f 'vllm serve' || true\", shell=True)\n",
        "time.sleep(3)\n",
        "\n",
        "log = open(\"/content/vllm.log\", \"w\")\n",
        "subprocess.Popen([\n",
        "    \"/content/venv/bin/vllm\", \"serve\", MODEL_DIR,\n",
        "    \"--port\", str(VLLM_PORT),\n",
        "    \"--trust-remote-code\",\n",
        "    \"--served-model-name\", \"spark2.6\",\n",
        "    \"--gpu-memory-utilization\", \"0.70\",\n",
        "    \"--max-model-len\", \"8192\",\n",
        "    \"--dtype\", \"float16\",\n",
        "    \"--enable-prefix-caching\",\n",
        "    \"--chat-template\", str(TEMPLATE),\n",
        "    \"--api-key\", API_KEY,\n",
        "], stdout=log, stderr=subprocess.STDOUT)\n",
        "\n",
        "print(\"vLLM 已后台启动\")\n",
        "print(f\"API Key: {API_KEY}\")\n",
        "print(\"查看进度: !tail -n 20 /content/vllm.log\")\n"
