        "import os, subprocess, time, urllib.request, secrets, re\n",
        "from pathlib import Path\n",
        "\n",
        "VLLM_PORT, WEBUI_PORT = 8000, 8080\n",
        "API_KEY = Path(\"/content/api_key.txt\").read_text().strip()\n",
        "\n",
        "def wait_ready(url, minutes, log_hint):\n",
        "    for i in range(minutes * 12):\n",
        "        time.sleep(5)\n",
        "        try:\n",
        "            with urllib.request.urlopen(url, timeout=3) as r:\n",
        "                if r.status == 200:\n",
        "                    return True\n",
        "        except Exception:\n",
        "            pass\n",
        "    print(f\"等待超时，查看日志: !tail -n 50 {log_hint}\")\n",
        "    return False\n",
        "\n",
        "print(\"等待 vLLM 就绪...\", flush=True)\n",
        "if not wait_ready(f\"http://127.0.0.1:{VLLM_PORT}/health\", 15, \"/content/vllm.log\"):\n",
        "    raise RuntimeError(\"vLLM 未就绪\")\n",
        "print(\"vLLM 就绪\", flush=True)\n",
        "\n",
        "data_dir = Path(\"/content/open-webui-data\"); data_dir.mkdir(exist_ok=True)\n",
        "os.environ.update({\n",
        "    \"OPENAI_API_BASE_URL\": f\"http://127.0.0.1:{VLLM_PORT}/v1\",\n",
        "    \"OPENAI_API_KEY\":      API_KEY,\n",
        "    \"ENABLE_OPENAI_API\":   \"True\",\n",
        "    \"WEBUI_SECRET_KEY\":    secrets.token_hex(32),\n",
        "    \"DATA_DIR\":            str(data_dir),\n",
        "    \"DEFAULT_MODELS\":      \"spark2.6\",\n",
        "})\n",
        "subprocess.run(\"pkill -f 'open-webui' || true\", shell=True)\n",
        "subprocess.Popen(\n",
        "    [\"/content/venv/bin/open-webui\", \"serve\", \"--port\", str(WEBUI_PORT)],\n",
        "    stdout=open(\"/content/webui.log\", \"w\"), stderr=subprocess.STDOUT)\n",
        "print(\"启动 Open WebUI ...\", flush=True)\n",
        "if not wait_ready(f\"http://127.0.0.1:{WEBUI_PORT}/health\", 3, \"/content/webui.log\"):\n",
        "    raise RuntimeError(\"Open WebUI 未就绪\")\n",
        "print(\"Open WebUI 就绪\", flush=True)\n",
        "\n",
        "cf_path = Path(\"/content/cloudflared\")\n",
        "if not cf_path.exists():\n",
        "    urllib.request.urlretrieve(\n",
        "        \"https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64\",\n",
        "        cf_path)\n",
        "    cf_path.chmod(0o755)\n",
        "\n",
        "def create_tunnel(port, name):\n",
        "    log_file = Path(f\"/content/tunnel_{name}.log\")\n",
        "    subprocess.Popen(\n",
        "        [str(cf_path), \"tunnel\", \"--url\", f\"http://127.0.0.1:{port}\"],\n",
        "        stdout=open(log_file, \"w\"), stderr=subprocess.STDOUT)\n",
        "    for _ in range(20):\n",
        "        time.sleep(2)\n",
        "        try:\n",
        "            m = re.search(r\"https://[a-zA-Z0-9-]+\\.trycloudflare\\.com\", log_file.read_text())\n",
        "            if m: return m.group(0)\n",
        "        except Exception: pass\n",
        "    return None\n",
        "\n",
        "webui_url = create_tunnel(WEBUI_PORT, \"webui\")\n",
        "api_url   = create_tunnel(VLLM_PORT, \"api\")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 66)\n",
        "print(\"部署完成\")\n",
        "print(\"=\" * 66)\n",
        "print(f\"Open WebUI : {webui_url}\")\n",
        "print(f\"首次访问注册管理员，模型选 spark2.6\")\n",
        "print(f\"OpenAI API : {api_url}/v1\")\n",
        "print(f\"模型名     : spark2.6\")\n",
        "print(f\"API Key    : {API_KEY}\")\n",
        "print(\"=\" * 66)\n",
        "print(\"trycloudflare 域名在会话结束后失效，运行下一格保持会话活跃\")\n"
